    "rebuild": "npm run clean && npm run build && npm run start"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.1.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.10.0",
    "shippo": "^2.18.0",
    "stripe": "^22.6.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "canvas": "^3.2.1",
    "eslint": "9.9.0",
    "eslint-config-next": "^16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.14"
  }
