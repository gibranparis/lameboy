{
  "name": "lameboy",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "restart": "bash -c 'kill -9 $(lsof -ti :3000,3001,3002) || true && next dev'",
