# Stripe — raw Payment Element + PaymentIntents (no Checkout Sessions)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from `stripe listen` locally, or the dashboard webhook endpoint in prod

# Supabase — products, variants, orders, order_items
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...             # service role key — server only, never expose to the client

# Shippo — live shipping rates
SHIPPO_API_KEY=shippo_test_...

# Ship-from address Shippo quotes rates against
SHIPPO_ORIGIN_NAME=Lameboy
SHIPPO_ORIGIN_ADDRESS1=123 Main St
SHIPPO_ORIGIN_ADDRESS2=
SHIPPO_ORIGIN_CITY=Miami
SHIPPO_ORIGIN_STATE=FL
SHIPPO_ORIGIN_ZIP=33101
SHIPPO_ORIGIN_COUNTRY=US
SHIPPO_ORIGIN_PHONE=
SHIPPO_ORIGIN_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter — email notifications for new subscribers
RESEND_API_KEY=re_...         # from resend.com → API Keys
NOTIFY_EMAIL=you@youremail.com  # where to receive submissions
